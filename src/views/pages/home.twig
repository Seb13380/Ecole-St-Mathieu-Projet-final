{% extends "../layouts/base.twig" %}

{% block title %}Ecole Saint-Mathieu
{% endblock %}

{% block main %}
	<div class="flex flex-col items-center px-4 gap-6">
		<h1 class="text-center font-bold text-3xl text-[#304a4d] mb-0">
			Bienvenue à l'Ecole Saint-Mathieu
		</h1>
		<h2 class="text-lg text-center text-[#304a4d] mb-6">
			L'école Saint-Mathieu est un établissement scolaire privé situé à Marseille Château Gombert, offrant une éducation de qualité aux élèves de la maternelle au primaire.
		</h2>
	</div>
	<div class="carousel w-full">
		<div id="slide1" class="carousel-item relative w-full">
			<img src="/assets/images/20250326_114849.jpg" class="w-full carousel-slide-img"/>
			<div class="absolute left-5 right-5 top-1/2 flex -translate-y-1/2 transform justify-between">
				<a href="#slide4" class="carousel-nav-btn">❮</a>
				<a href="#slide2" class="carousel-nav-btn">❯</a>
			</div>
		</div>
		<div id="slide2" class="carousel-item relative w-full">
			<img src="/assets/images/20250326_114954.jpg" class="w-full carousel-slide-img"/>
			<div class="absolute left-5 right-5 top-1/2 flex -translate-y-1/2 transform justify-between">
				<a href="#slide1" class="carousel-nav-btn">❮</a>
				<a href="#slide3" class="carousel-nav-btn">❯</a>
			</div>
		</div>
		<div id="slide3" class="carousel-item relative w-full">
			<img src="/assets/images/20250514_114720.jpg" class="w-full carousel-slide-img"/>
			<div class="absolute left-5 right-5 top-1/2 flex -translate-y-1/2 transform justify-between">
				<a href="#slide2" class="carousel-nav-btn">❮</a>
				<a href="#slide4" class="carousel-nav-btn">❯</a>
			</div>
		</div>
		<div id="slide4" class="carousel-item relative w-full">
			<img src="/assets/images/47d2b2f0-69d4-4913-b80c-5da660a12e2e.jpg" class="w-full carousel-slide-img"/>
			<div class="absolute left-5 right-5 top-1/2 flex -translate-y-1/2 transform justify-between">
				<a href="#slide3" class="carousel-nav-btn">❮</a>
				<a href="#slide1" class="carousel-nav-btn">❯</a>
			</div>
		</div>
	</div>

	<style>
		.carousel {
			scroll-behavior: smooth;
			scroll-snap-type: x mandatory;
		}

		.carousel-item {
			scroll-snap-align: start;
		}

		.carousel-slide-img {
			height: 16rem;
			object-fit: cover;
			display: block;
		}

		@media(min-width: 640px) {
			.carousel-slide-img {
				height: 20rem;
			}
		}

		@media(min-width: 768px) {
			.carousel-slide-img {
				height: 420px;
			}
		}

		@media(min-width: 1024px) {
			.carousel-slide-img {
				height: 80vh;
				max-height: 700px;
			}
		}

		.carousel-nav-btn {
			pointer-events: auto;
			display: flex;
			align-items: center;
			justify-content: center;
			width: 2.75rem;
			height: 2.75rem;
			border-radius: 9999px;
			background-color: rgba(48, 74, 77, 0.5);
			color: #ffffff;
			font-size: 1.25rem;
			backdrop-filter: blur(4px);
			transition: background-color 0.2s ease, transform 0.2s ease;
		}

		.carousel-nav-btn:hover {
			background-color: rgba(48, 74, 77, 0.8);
			transform: scale(1.08);
		}
	</style>

	{% if actualites and actualites|length > 0 %}
		<div class="w-full px-4 mt-8">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-2xl font-bold text-[#304a4d] mb-6 text-center">Actualités</h2>
				<div class="grid gap-8">
					{% for actu in actualites %}
						<article style="background: linear-gradient(135deg, #f0fdfa 0%, #ccfbf1 25%, #99f6e4 50%, #5eead4 100%); backdrop-filter: blur(8px); box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1); border-radius: 16px; overflow: hidden; transition: all 0.3s ease; border: 2px solid #5eead4;" onmouseover="this.style.transform='scale(1.01)'; this.style.boxShadow='0 20px 40px rgba(0, 0, 0, 0.15)'; this.style.background='linear-gradient(135deg, #ecfdf5 0%, #a7f3d0 25%, #6ee7b7 50%, #34d399 100%)'" onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='0 10px 25px rgba(0, 0, 0, 0.1)'; this.style.background='linear-gradient(135deg, #f0fdfa 0%, #ccfbf1 25%, #99f6e4 50%, #5eead4 100%)'">
							{% if actu.important %}
								<div style="background: linear-gradient(135deg, #0d9488 0%, #0f766e 50%, #134e4a 100%); padding: 14px; position: relative; overflow: hidden;">
									<div class="flex items-center justify-center">
										<div style="background: rgba(255,255,255,0.2); border-radius: 50%; padding: 5px; margin-right: 10px;">
											<svg style="width: 18px; height: 18px; color: #ffffff;" fill="none" stroke="currentColor" viewbox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
											</svg>
										</div>
										<span style="color: #ffffff; font-size: 14px; font-weight: bold; letter-spacing: 1px; text-transform: uppercase;">Information Importante</span>
									</div>
								</div>
							{% endif %}
							<div class="p-6 md:p-8 text-center">
								<h3 class="text-xl font-bold text-gray-900 mb-2">{{ actu.titre }}</h3>
								<p class="text-sm text-gray-500 mb-3">{{ actu.datePublication|date('d/m/Y') }}</p>
								<p class="text-gray-700 text-base leading-relaxed">{{ actu.contenu|slice(0, 200) }}
									{% if actu.contenu|length > 200 %}…
									{% endif %}
								</p>
								{% if actu.lienUrl %}
									<div class="mt-5">
										<a href="{{ actu.lienUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl hover:scale-105 hover:from-blue-600 hover:to-blue-700 transition-all duration-300 border border-blue-400">
											<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
											</svg>
											{{ actu.lienTexte ? actu.lienTexte : 'En savoir plus' }}
										</a>
									</div>
								{% endif %}
							</div>
						</article>
					{% endfor %}
				</div>
				<div class="text-center mt-6">
					<a href="/actualites" class="inline-flex items-center px-5 py-2 bg-[#304a4d] text-white rounded-lg hover:bg-[#253b3e] transition-colors text-sm font-medium">
						Voir toutes les actualités →
					</a>
				</div>
			</div>
		</div>
	{% endif %}

{% endblock %}

{% block scripts %}
	<script>
		document.addEventListener('DOMContentLoaded', function () {
const carousel = document.querySelector('.carousel');
const items = document.querySelectorAll('.carousel-item');
let index = 0;
setInterval(() => {
index = (index + 1) % items.length;
carousel.scrollLeft = items[index].offsetLeft;
}, 7000);
});
	</script>
{% endblock %}
