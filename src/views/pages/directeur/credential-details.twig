{% extends "layouts/base.twig" %}

{% block main %}
	<div class="min-h-screen bg-gradient-to-br from-blue-50 to-slate-100">
		<div class="container mx-auto px-4 py-8">

			<!-- En-tête de page -->
			<div class="bg-white rounded-lg shadow-md p-6 mb-8">
				<div class="flex items-center justify-between">
					<div class="flex items-center">
						<div class="bg-indigo-500 p-3 rounded-lg mr-4">
							<svg class="h-8 w-8 text-white" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
							</svg>
						</div>
						<div>
							<h1 class="text-3xl font-bold text-slate-800">Détails de la demande d'identifiants</h1>
							<p class="text-slate-600">Demande #{{ request.id }} - {{ request.createdAt|date('d/m/Y à H:i') }}</p>
						</div>
					</div>
					<a href="/directeur/credentials" class="bg-slate-500 hover:bg-slate-600 text-white px-4 py-2 rounded-lg transition-colors flex items-center">
						<svg class="h-5 w-5 mr-2" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
						</svg>
						Retour à la liste
					</a>
				</div>
			</div>

			<!-- Statut de la demande -->
			<div class="bg-white rounded-lg shadow-md p-6 mb-8">
				<h2 class="text-xl font-bold text-slate-800 mb-4">📊 Statut de la demande</h2>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
					<div class="p-4 bg-slate-50 rounded-lg">
						<p class="text-sm text-slate-600 mb-1">Statut actuel</p>
						<p class="text-lg font-bold">
							{% if request.status == 'PENDING' %}
								<span class="text-yellow-600">⏳ En attente</span>
							{% elseif request.status == 'PROCESSING' %}
								<span class="text-blue-600">🔄 En traitement</span>
							{% elseif request.status == 'COMPLETED' %}
								<span class="text-green-600">✅ Complétée</span>
							{% elseif request.status == 'REJECTED' %}
								<span class="text-red-600">❌ Rejetée</span>
							{% elseif request.status == 'FAILED' %}
								<span class="text-red-600">⚠️ Échouée</span>
							{% endif %}
						</p>
					</div>
					<div class="p-4 bg-slate-50 rounded-lg">
						<p class="text-sm text-slate-600 mb-1">Traitée</p>
						<p class="text-lg font-bold">{{ request.processed ? '✅ Oui' : '❌ Non' }}</p>
					</div>
					<div class="p-4 bg-slate-50 rounded-lg">
						<p class="text-sm text-slate-600 mb-1">Identifiants envoyés</p>
						<p class="text-lg font-bold">{{ request.identifiersSent ? '✅ Oui' : '❌ Non' }}</p>
					</div>
				</div>
				
				{% if request.processedAt %}
					<div class="mt-4 p-4 bg-blue-50 rounded-lg">
						<p class="text-sm text-slate-600">Traitée le : <span class="font-semibold">{{ request.processedAt|date('d/m/Y à H:i') }}</span></p>
					</div>
				{% endif %}

				{% if request.errorMessage %}
					<div class="mt-4 p-4 bg-red-50 border-l-4 border-red-500 rounded-lg">
						<p class="text-sm text-red-800"><strong>⚠️ Message d'erreur :</strong> {{ request.errorMessage }}</p>
					</div>
				{% endif %}

				{% if request.adminNotes %}
					<div class="mt-4 p-4 bg-yellow-50 border-l-4 border-yellow-500 rounded-lg">
						<p class="text-sm text-yellow-800"><strong>📝 Notes de l'administrateur :</strong></p>
						<p class="mt-2 text-sm text-slate-700">{{ request.adminNotes }}</p>
					</div>
				{% endif %}
			</div>

			<!-- Informations du demandeur -->
			<div class="bg-white rounded-lg shadow-md p-6 mb-8">
				<h2 class="text-xl font-bold text-slate-800 mb-4">👤 Informations fournies par le demandeur</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div class="p-4 bg-blue-50 rounded-lg border-l-4 border-blue-500">
						<p class="text-sm text-slate-600 mb-1">Prénom</p>
						<p class="text-lg font-bold text-slate-900">{{ request.requestedFirstName }}</p>
					</div>
					<div class="p-4 bg-blue-50 rounded-lg border-l-4 border-blue-500">
						<p class="text-sm text-slate-600 mb-1">Nom</p>
						<p class="text-lg font-bold text-slate-900">{{ request.requestedLastName }}</p>
					</div>
					<div class="p-4 bg-blue-50 rounded-lg border-l-4 border-blue-500">
						<p class="text-sm text-slate-600 mb-1">Email</p>
						<p class="text-lg font-bold text-slate-900">{{ request.requestedEmail }}</p>
					</div>
					<div class="p-4 bg-blue-50 rounded-lg border-l-4 border-blue-500">
						<p class="text-sm text-slate-600 mb-1">Téléphone</p>
						<p class="text-lg font-bold text-slate-900">{{ request.requestedPhone ?? 'Non fourni' }}</p>
					</div>
				</div>
			</div>

			<!-- Correspondance parent -->
			<div class="bg-white rounded-lg shadow-md p-6 mb-8">
				<h2 class="text-xl font-bold text-slate-800 mb-4">🔍 Correspondance avec parent existant</h2>
				
				{% if request.foundParent %}
					<div class="p-4 bg-green-50 border-l-4 border-green-500 rounded-lg mb-6">
						<p class="text-lg font-bold text-green-800 mb-2">✅ Parent trouvé en base de données</p>
						<p class="text-sm text-green-700">Un compte parent correspondant a été identifié dans le système.</p>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div class="p-4 bg-green-50 rounded-lg border-l-4 border-green-500">
							<p class="text-sm text-slate-600 mb-1">Prénom (en base)</p>
							<p class="text-lg font-bold text-slate-900">{{ request.foundParent.firstName }}</p>
						</div>
						<div class="p-4 bg-green-50 rounded-lg border-l-4 border-green-500">
							<p class="text-sm text-slate-600 mb-1">Nom (en base)</p>
							<p class="text-lg font-bold text-slate-900">{{ request.foundParent.lastName }}</p>
						</div>
						<div class="p-4 bg-green-50 rounded-lg border-l-4 border-green-500">
							<p class="text-sm text-slate-600 mb-1">Email (en base)</p>
							<p class="text-lg font-bold text-slate-900">{{ request.foundParent.email }}</p>
						</div>
						<div class="p-4 bg-green-50 rounded-lg border-l-4 border-green-500">
							<p class="text-sm text-slate-600 mb-1">Rôle</p>
							<p class="text-lg font-bold text-slate-900">{{ request.foundParent.role }}</p>
						</div>
						<div class="p-4 bg-green-50 rounded-lg border-l-4 border-green-500">
							<p class="text-sm text-slate-600 mb-1">Téléphone (en base)</p>
							<p class="text-lg font-bold text-slate-900">{{ request.foundParent.phone ?? 'Non renseigné' }}</p>
						</div>
						<div class="p-4 bg-green-50 rounded-lg border-l-4 border-green-500">
							<p class="text-sm text-slate-600 mb-1">ID Parent</p>
							<p class="text-lg font-bold text-slate-900">#{{ request.foundParent.id }}</p>
						</div>
					</div>

					<!-- Enfants du parent -->
					{% if parentChildren|length > 0 %}
						<div class="mt-6">
							<h3 class="text-lg font-bold text-slate-800 mb-4">👶 Enfants associés à ce parent</h3>
							<div class="space-y-3">
								{% for child in parentChildren %}
									<div class="p-4 bg-slate-50 rounded-lg border border-slate-200">
										<div class="flex items-center justify-between">
											<div>
												<p class="text-base font-bold text-slate-900">
													{{ child.firstName }} {{ child.lastName }}
												</p>
												<p class="text-sm text-slate-600">
													Classe : {{ child.className ?? 'Non assignée' }}
													{% if child.dateOfBirth %}
														| Né(e) le : {{ child.dateOfBirth|date('d/m/Y') }}
													{% endif %}
												</p>
											</div>
											<span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">
												Élève #{{ child.id }}
											</span>
										</div>
									</div>
								{% endfor %}
							</div>
						</div>
					{% else %}
						<div class="mt-6 p-4 bg-yellow-50 border-l-4 border-yellow-500 rounded-lg">
							<p class="text-sm text-yellow-800">⚠️ Aucun enfant n'est actuellement associé à ce parent.</p>
						</div>
					{% endif %}

					<!-- Tableau de comparaison -->
					<div class="mt-6">
						<h3 class="text-lg font-bold text-slate-800 mb-4">📊 Comparaison des informations</h3>
						<div class="overflow-x-auto">
							<table class="min-w-full border border-slate-200 rounded-lg">
								<thead class="bg-slate-100">
									<tr>
										<th class="px-4 py-3 text-left text-sm font-bold text-slate-700 border-b">Champ</th>
										<th class="px-4 py-3 text-left text-sm font-bold text-slate-700 border-b">Demandé</th>
										<th class="px-4 py-3 text-left text-sm font-bold text-slate-700 border-b">En base</th>
										<th class="px-4 py-3 text-left text-sm font-bold text-slate-700 border-b">Correspondance</th>
									</tr>
								</thead>
								<tbody class="bg-white divide-y divide-slate-200">
									<tr>
										<td class="px-4 py-3 text-sm font-medium text-slate-900">Prénom</td>
										<td class="px-4 py-3 text-sm text-slate-700">{{ request.requestedFirstName }}</td>
										<td class="px-4 py-3 text-sm text-slate-700">{{ request.foundParent.firstName }}</td>
										<td class="px-4 py-3 text-sm">
											{% if request.requestedFirstName|lower == request.foundParent.firstName|lower %}
												<span class="text-green-600 font-bold">✅ Identique</span>
											{% else %}
												<span class="text-orange-600 font-bold">⚠️ Différent</span>
											{% endif %}
										</td>
									</tr>
									<tr>
										<td class="px-4 py-3 text-sm font-medium text-slate-900">Nom</td>
										<td class="px-4 py-3 text-sm text-slate-700">{{ request.requestedLastName }}</td>
										<td class="px-4 py-3 text-sm text-slate-700">{{ request.foundParent.lastName }}</td>
										<td class="px-4 py-3 text-sm">
											{% if request.requestedLastName|lower == request.foundParent.lastName|lower %}
												<span class="text-green-600 font-bold">✅ Identique</span>
											{% else %}
												<span class="text-orange-600 font-bold">⚠️ Différent</span>
											{% endif %}
										</td>
									</tr>
									<tr>
										<td class="px-4 py-3 text-sm font-medium text-slate-900">Email</td>
										<td class="px-4 py-3 text-sm text-slate-700">{{ request.requestedEmail }}</td>
										<td class="px-4 py-3 text-sm text-slate-700">{{ request.foundParent.email }}</td>
										<td class="px-4 py-3 text-sm">
											{% if request.requestedEmail|lower == request.foundParent.email|lower %}
												<span class="text-green-600 font-bold">✅ Identique</span>
											{% else %}
												<span class="text-red-600 font-bold">❌ Différent</span>
											{% endif %}
										</td>
									</tr>
									<tr>
										<td class="px-4 py-3 text-sm font-medium text-slate-900">Téléphone</td>
										<td class="px-4 py-3 text-sm text-slate-700">{{ request.requestedPhone ?? 'Non fourni' }}</td>
										<td class="px-4 py-3 text-sm text-slate-700">{{ request.foundParent.phone ?? 'Non renseigné' }}</td>
										<td class="px-4 py-3 text-sm">
											{% if request.requestedPhone and request.foundParent.phone %}
												{% if request.requestedPhone == request.foundParent.phone %}
													<span class="text-green-600 font-bold">✅ Identique</span>
												{% else %}
													<span class="text-orange-600 font-bold">⚠️ Différent</span>
												{% endif %}
											{% else %}
												<span class="text-slate-500">— Non comparable</span>
											{% endif %}
										</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>

				{% else %}
					<div class="p-6 bg-red-50 border-l-4 border-red-500 rounded-lg">
						<p class="text-lg font-bold text-red-800 mb-2">❌ Aucun parent trouvé</p>
						<p class="text-sm text-red-700 mb-4">Aucun compte parent correspondant à ces informations n'a été trouvé dans la base de données.</p>
						<div class="p-4 bg-white rounded-lg border border-red-200">
							<p class="text-sm text-slate-700 mb-2"><strong>Raisons possibles :</strong></p>
							<ul class="list-disc list-inside text-sm text-slate-600 space-y-1">
								<li>L'email fourni ne correspond à aucun compte parent</li>
								<li>Le prénom ou le nom ne correspond pas (faute de frappe)</li>
								<li>Le parent n'a pas encore de compte dans le système</li>
							</ul>
						</div>
					</div>
				{% endif %}
			</div>

			<!-- Actions -->
			{% if request.status == 'PENDING' or request.status == 'PROCESSING' %}
				<div class="bg-white rounded-lg shadow-md p-6">
					<h2 class="text-xl font-bold text-slate-800 mb-4">🎯 Actions</h2>
					<div class="flex space-x-4">
						<button onclick="approveRequest({{ request.id }})" class="flex-1 bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-bold transition-colors flex items-center justify-center">
							<svg class="h-5 w-5 mr-2" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
							</svg>
							Approuver et envoyer les identifiants
						</button>
						<button onclick="rejectRequest({{ request.id }})" class="flex-1 bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-lg font-bold transition-colors flex items-center justify-center">
							<svg class="h-5 w-5 mr-2" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
							</svg>
							Rejeter la demande
						</button>
					</div>
				</div>
			{% endif %}
		</div>
	</div>

	<!-- Modales -->
	<div id="approveModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
		<div class="flex items-center justify-center min-h-screen px-4">
			<div class="bg-white rounded-lg max-w-md w-full p-6">
				<h3 class="text-lg font-medium text-slate-900 mb-4">Approuver la demande</h3>
				<p class="text-slate-600 mb-4">Confirmer l'envoi des nouveaux identifiants à ce parent ?</p>
				<textarea id="approveNotes" placeholder="Notes optionnelles..." class="w-full p-3 border border-slate-300 rounded-lg mb-4"></textarea>
				<div class="flex justify-end space-x-3">
					<button onclick="closeModal('approveModal')" class="px-4 py-2 text-slate-600 hover:text-slate-800">Annuler</button>
					<button id="confirmApprove" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">Approuver</button>
				</div>
			</div>
		</div>
	</div>

	<div id="rejectModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
		<div class="flex items-center justify-center min-h-screen px-4">
			<div class="bg-white rounded-lg max-w-md w-full p-6">
				<h3 class="text-lg font-medium text-slate-900 mb-4">Rejeter la demande</h3>
				<p class="text-slate-600 mb-4">Indiquer la raison du rejet :</p>
				<textarea id="rejectReason" placeholder="Raison du rejet..." class="w-full p-3 border border-slate-300 rounded-lg mb-4" required></textarea>
				<textarea id="rejectNotes" placeholder="Notes optionnelles..." class="w-full p-3 border border-slate-300 rounded-lg mb-4"></textarea>
				<div class="flex justify-end space-x-3">
					<button onclick="closeModal('rejectModal')" class="px-4 py-2 text-slate-600 hover:text-slate-800">Annuler</button>
					<button id="confirmReject" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">Rejeter</button>
				</div>
			</div>
		</div>
	</div>

	<script>
		function approveRequest(id) {
			document.getElementById('approveModal').classList.remove('hidden');
		}

		function rejectRequest(id) {
			document.getElementById('rejectModal').classList.remove('hidden');
		}

		function closeModal(modalId) {
			document.getElementById(modalId).classList.add('hidden');
		}

		document.getElementById('confirmApprove').addEventListener('click', function() {
			const notes = document.getElementById('approveNotes').value;
			
			fetch('/directeur/credentials/{{ request.id }}/approve', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json'
				},
				body: JSON.stringify({ notes })
			})
			.then(response => response.json())
			.then(data => {
				if (data.success) {
					alert('✅ Demande approuvée avec succès !');
					window.location.href = '/directeur/credentials';
				} else {
					alert('❌ Erreur : ' + data.message);
				}
			})
			.catch(error => {
				console.error('Erreur:', error);
				alert('❌ Erreur lors de l\'approbation');
			});
		});

		document.getElementById('confirmReject').addEventListener('click', function() {
			const reason = document.getElementById('rejectReason').value;
			const notes = document.getElementById('rejectNotes').value;

			if (!reason) {
				alert('⚠️ Veuillez indiquer une raison pour le rejet');
				return;
			}
			
			fetch('/directeur/credentials/{{ request.id }}/reject', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json'
				},
				body: JSON.stringify({ reason, notes })
			})
			.then(response => response.json())
			.then(data => {
				if (data.success) {
					alert('✅ Demande rejetée');
					window.location.href = '/directeur/credentials';
				} else {
					alert('❌ Erreur : ' + data.message);
				}
			})
			.catch(error => {
				console.error('Erreur:', error);
				alert('❌ Erreur lors du rejet');
			});
		});

		// Fermer les modales en cliquant à l'extérieur
		['approveModal', 'rejectModal'].forEach(modalId => {
			document.getElementById(modalId).addEventListener('click', function(e) {
				if (e.target === this) {
					closeModal(modalId);
				}
			});
		});
	</script>
{% endblock %}
