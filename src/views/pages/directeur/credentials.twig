{% extends "layouts/base.twig" %}

{% block main %}
	<div class="min-h-screen bg-gradient-to-br from-blue-50 to-slate-100">
		<div
			class="container mx-auto px-4 py-8">

			<!-- En-tête de page -->
			<div class="bg-white rounded-lg shadow-md p-6 mb-8">
				<div class="flex items-center justify-between">
					<div class="flex items-center">
						<div class="bg-indigo-500 p-3 rounded-lg mr-4">
							<svg class="h-8 w-8 text-white" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
							</svg>
						</div>
						<div>
							<h1 class="text-3xl font-bold text-slate-800">Demandes d'Identifiants</h1>
							<p class="text-slate-600">Gestion des demandes de connexion des parents</p>
						</div>
					</div>
					<a href="{% if user.role == 'SECRETAIRE_DIRECTION' %}/secretaire/dashboard{% else %}/directeur/dashboard{% endif %}" class="bg-slate-500 hover:bg-slate-600 text-white px-4 py-2 rounded-lg transition-colors flex items-center">
						<svg class="h-5 w-5 mr-2" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
						</svg>
						Retour au Dashboard
					</a>
				</div>
			</div>

			<!-- Statistiques -->
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4 sm:gap-6 mb-6 sm:mb-8">
				<div class="bg-white rounded-lg shadow-md p-4 sm:p-6 border-l-4 border-slate-500">
					<div class="flex items-center">
						<div class="flex-shrink-0">
							<div class="bg-slate-100 p-2 sm:p-3 rounded-lg">
								<svg class="h-6 w-6 sm:h-8 sm:w-8 text-slate-600" fill="none" viewbox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
								</svg>
							</div>
						</div>
						<div class="ml-3 sm:ml-4">
							<p class="text-xs sm:text-sm font-medium text-slate-600">Total</p>
							<p class="text-xl sm:text-2xl font-bold text-slate-900">{{ stats.total }}</p>
						</div>
					</div>
				</div>

				<div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-yellow-500">
					<div class="flex items-center">
						<div class="flex-shrink-0">
							<div class="bg-yellow-100 p-3 rounded-lg">
								<svg class="h-8 w-8 text-yellow-600" fill="none" viewbox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
								</svg>
							</div>
						</div>
						<div class="ml-4">
							<p class="text-sm font-medium text-slate-600">En attente</p>
							<p class="text-2xl font-bold text-yellow-900">{{ stats.pending }}</p>
						</div>
					</div>
				</div>

				<div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-blue-500">
					<div class="flex items-center">
						<div class="flex-shrink-0">
							<div class="bg-blue-100 p-3 rounded-lg">
								<svg class="h-8 w-8 text-blue-600" fill="none" viewbox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
								</svg>
							</div>
						</div>
						<div class="ml-4">
							<p class="text-sm font-medium text-slate-600">En traitement</p>
							<p class="text-2xl font-bold text-blue-900">{{ stats.processing }}</p>
						</div>
					</div>
				</div>

				<div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-green-500">
					<div class="flex items-center">
						<div class="flex-shrink-0">
							<div class="bg-green-100 p-3 rounded-lg">
								<svg class="h-8 w-8 text-green-600" fill="none" viewbox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
								</svg>
							</div>
						</div>
						<div class="ml-4">
							<p class="text-sm font-medium text-slate-600">Complétées</p>
							<p class="text-2xl font-bold text-green-900">{{ stats.completed }}</p>
						</div>
					</div>
				</div>

				<div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-red-500">
					<div class="flex items-center">
						<div class="flex-shrink-0">
							<div class="bg-red-100 p-3 rounded-lg">
								<svg class="h-8 w-8 text-red-600" fill="none" viewbox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
								</svg>
							</div>
						</div>
						<div class="ml-4">
							<p class="text-sm font-medium text-slate-600">Rejetées</p>
							<p class="text-2xl font-bold text-red-900">{{ stats.rejected }}</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Liste des demandes -->
			<div class="bg-white rounded-lg shadow-md overflow-hidden">
				<div class="px-6 py-4 border-b border-slate-200">
					<h2 class="text-xl font-bold text-slate-800 mb-4">Liste des demandes</h2>

					<!-- Filtres et recherche -->
					<div
						class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
						<!-- Recherche textuelle -->
						<div class="md:col-span-2">
							<label for="searchText" class="block text-sm font-medium text-slate-700 mb-1">🔍 Rechercher</label>
							<input type="text" id="searchText" placeholder="Nom, prénom, email..." class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" oninput="filterRequests()">
						</div>

						<!-- Filtre par statut -->
						<div>
							<label for="filterStatus" class="block text-sm font-medium text-slate-700 mb-1">📊 Statut</label>
							<select id="filterStatus" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" onchange="filterRequests()">
								<option value="">Tous les statuts</option>
								<option value="PENDING">En attente</option>
								<option value="PROCESSING">En traitement</option>
								<option value="COMPLETED">Complétée</option>
								<option value="REJECTED">Rejetée</option>
								<option value="FAILED">Échec</option>
							</select>
						</div>

						<!-- Tri -->
						<div>
							<label for="sortBy" class="block text-sm font-medium text-slate-700 mb-1">↕️ Trier par</label>
							<select id="sortBy" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" onchange="sortRequests()">
								<option value="date-desc">Date (plus récent)</option>
								<option value="date-asc">Date (plus ancien)</option>
								<option value="name-asc">Nom (A-Z)</option>
								<option value="name-desc">Nom (Z-A)</option>
							</select>
						</div>
					</div>

					<div class="mt-3 text-sm text-slate-600">
						<span id="resultsCount">{{ credentialsRequests|length }}</span>
						demande(s) affichée(s)
					</div>

					{% if credentialsRequests|length > 0 %}
						<div class="overflow-x-auto">
							<table class="min-w-full divide-y divide-slate-200">
								<thead class="bg-slate-50">
									<tr>
										<th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Date</th>
										<th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Demandeur</th>
										<th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Parent trouvé</th>
										<th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Statut</th>
										<th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Actions</th>
									</tr>
								</thead>
								<tbody class="bg-white divide-y divide-slate-200">
									{% for request in credentialsRequests %}
										<tr class="hover:bg-slate-50 request-row" data-firstname="{{ request.requestedFirstName|lower }}" data-lastname="{{ request.requestedLastName|lower }}" data-email="{{ request.requestedEmail|lower }}" data-status="{{ request.status }}" data-created="{{ request.createdAt|date('Y-m-d H:i:s') }}" data-lastname-raw="{{ request.requestedLastName }}" data-detail-id="{{ request.id }}" data-detail-firstname="{{ request.requestedFirstName|e('html_attr') }}" data-detail-lastname="{{ request.requestedLastName|e('html_attr') }}" data-detail-email="{{ request.requestedEmail|e('html_attr') }}" data-detail-phone="{{ request.requestedPhone ? request.requestedPhone|e('html_attr') : '' }}" data-detail-status="{{ request.status }}" data-detail-createdat="{{ request.createdAt|date('d/m/Y H:i') }}" data-detail-processedat="{{ request.processedAt ? request.processedAt|date('d/m/Y H:i') : '' }}" data-detail-notes="{{ request.adminNotes ? request.adminNotes|e('html_attr') : '' }}" data-detail-error="{{ request.errorMessage ? request.errorMessage|e('html_attr') : '' }}" data-detail-parent-firstname="{{ request.foundParent ? request.foundParent.firstName|e('html_attr') : '' }}" data-detail-parent-lastname="{{ request.foundParent ? request.foundParent.lastName|e('html_attr') : '' }}" data-detail-parent-email="{{ request.foundParent ? request.foundParent.email|e('html_attr') : '' }}" data-detail-parent-role="{{ request.foundParent ? request.foundParent.role : '' }}">
											<td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900">
												{{ request.createdAt|date('d/m/Y H:i') }}
											</td>
											<td class="px-6 py-4 whitespace-nowrap">
												<div>
													<div class="text-sm font-medium text-slate-900">
														{{ request.requestedFirstName }}
														{{ request.requestedLastName }}
													</div>
													<div class="text-sm text-slate-500">{{ request.requestedEmail }}</div>
												</div>
											</td>
											<td class="px-6 py-4 whitespace-nowrap">
												{% if request.foundParent %}
													<div>
														<div class="text-sm font-medium text-slate-900">
															{{ request.foundParent.firstName }}
															{{ request.foundParent.lastName }}
														</div>
														<div class="text-sm text-slate-500">{{ request.foundParent.email }}</div>
														<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
															{{ request.foundParent.role }}
														</span>
													</div>
												{% else %}
													<div class="flex flex-col gap-1">
														<span class="text-sm text-orange-600 font-medium">⚠ Aucun parent trouvé</span>
														{% if request.status != 'COMPLETED' and request.status != 'REJECTED' %}
															<button onclick="openLinkParentModal({{ request.id }}, '{{ request.requestedFirstName|e('js') }}', '{{ request.requestedLastName|e('js') }}', '{{ request.requestedEmail|e('js') }}', '{{ request.requestedPhone|e('js') }}')\" class="text-xs text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-2 py-1 rounded transition-colors text-left">
																🔍 Rechercher parent
															</button>
														{% endif %}
													</div>
												{% endif %}
											</td>
											<td class="px-6 py-4 whitespace-nowrap">
												{% if request.status == 'PENDING' %}
													<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
														En attente
													</span>
												{% elseif request.status == 'PROCESSING' %}
													<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
														En traitement
													</span>
												{% elseif request.status == 'COMPLETED' %}
													<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
														Complétée
													</span>
												{% elseif request.status == 'REJECTED' %}
													<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
														Rejetée
													</span>
												{% elseif request.status == 'FAILED' %}
													<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
														Échec recherche
													</span>
												{% endif %}
											</td>
											<td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
												<div class="flex flex-wrap gap-1">
													{% if request.status == 'PENDING' or request.status == 'PROCESSING' or request.status == 'FAILED' %}
														{% if request.foundParent %}
															<button onclick="approveRequest({{ request.id }})" class="text-green-600 hover:text-green-900 bg-green-100 hover:bg-green-200 px-3 py-1 rounded-md transition-colors">
																<svg class="h-4 w-4 inline mr-1" fill="none" viewbox="0 0 24 24" stroke="currentColor">
																	<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
																</svg>
																Approuver
															</button>
														{% else %}
															<button onclick="openLinkParentModal({{ request.id }}, '{{ request.requestedFirstName|e('js') }}', '{{ request.requestedLastName|e('js') }}', '{{ request.requestedEmail|e('js') }}', '{{ request.requestedPhone|e('js') }}')\" class="text-indigo-600 hover:text-indigo-900 bg-indigo-100 hover:bg-indigo-200 px-3 py-1 rounded-md transition-colors">
																🔍 Lier un parent
															</button>
														{% endif %}
														<button onclick="rejectRequest({{ request.id }})" class="text-red-600 hover:text-red-900 bg-red-100 hover:bg-red-200 px-3 py-1 rounded-md transition-colors">
															<svg class="h-4 w-4 inline mr-1" fill="none" viewbox="0 0 24 24" stroke="currentColor">
																<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
															</svg>
															Rejeter
														</button>
													{% endif %}
													<button onclick="deleteRequest({{ request.id }})" class="text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 px-3 py-1 rounded-md transition-colors">
														<svg class="h-4 w-4 inline mr-1" fill="none" viewbox="0 0 24 24" stroke="currentColor">
															<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
														</svg>
														Supprimer
													</button>
													<button onclick="showDetail(this.closest('tr'))" class="text-indigo-600 hover:text-indigo-900 bg-indigo-100 hover:bg-indigo-200 px-3 py-1 rounded-md transition-colors">
														<svg class="h-4 w-4 inline mr-1" fill="none" viewbox="0 0 24 24" stroke="currentColor">
															<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
															<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
														</svg>
														Détail
													</button>
												</div>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% else %}
						<div class="px-6 py-8 text-center">
							<div class="text-slate-400 mb-4">
								<svg class="mx-auto h-16 w-16" fill="none" viewbox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
								</svg>
							</div>
							<h3 class="text-lg font-medium text-slate-900 mb-2">Aucune demande d'identifiants</h3>
							<p class="text-slate-500">Aucune demande n'a été soumise pour le moment.</p>
						</div>
					{% endif %}
				</div>
			</div>
		</div>

		<!-- Modal Détail -->
		<div id="detailModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
			<div class="flex items-center justify-center min-h-screen px-4">
				<div class="bg-white rounded-lg max-w-lg w-full p-6 shadow-xl">
					<div class="flex items-center justify-between mb-4">
						<h3 class="text-lg font-bold text-slate-900">Détail de la demande</h3>
						<button onclick="closeModal('detailModal')" class="text-slate-400 hover:text-slate-600">
							<svg class="h-6 w-6" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
							</svg>
						</button>
					</div>
					<div class="space-y-3 text-sm">
						<div class="bg-slate-50 rounded-lg p-4">
							<h4 class="font-semibold text-slate-700 mb-2">Demandeur</h4>
							<p>
								<span class="text-slate-500">Nom :</span>
								<span id="d-name" class="font-medium text-slate-900"></span>
							</p>
							<p>
								<span class="text-slate-500">Email :</span>
								<span id="d-email" class="font-medium text-slate-900"></span>
							</p>
							<p>
								<span class="text-slate-500">Téléphone :</span>
								<span id="d-phone" class="font-medium text-slate-900"></span>
							</p>
						</div>
						<div id="d-parent-section" class="bg-blue-50 rounded-lg p-4 hidden">
							<h4 class="font-semibold text-blue-700 mb-2">Parent trouvé en base</h4>
							<p>
								<span class="text-slate-500">Nom :</span>
								<span id="d-parent-name" class="font-medium text-slate-900"></span>
							</p>
							<p>
								<span class="text-slate-500">Email :</span>
								<span id="d-parent-email" class="font-medium text-slate-900"></span>
							</p>
							<p>
								<span class="text-slate-500">Rôle :</span>
								<span id="d-parent-role" class="font-medium text-slate-900"></span>
							</p>
						</div>
						<div class="bg-slate-50 rounded-lg p-4">
							<h4 class="font-semibold text-slate-700 mb-2">Traitement</h4>
							<p>
								<span class="text-slate-500">Statut :</span>
								<span id="d-status" class="font-medium"></span>
							</p>
							<p>
								<span class="text-slate-500">Date demande :</span>
								<span id="d-createdat" class="font-medium text-slate-900"></span>
							</p>
							<p>
								<span class="text-slate-500">Date traitement :</span>
								<span id="d-processedat" class="font-medium text-slate-900"></span>
							</p>
						</div>
						<div id="d-notes-section" class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 hidden">
							<h4 class="font-semibold text-yellow-700 mb-1">Notes admin</h4>
							<p id="d-notes" class="text-slate-700"></p>
						</div>
						<div id="d-error-section" class="bg-red-50 border border-red-200 rounded-lg p-4 hidden">
							<h4 class="font-semibold text-red-700 mb-1">Message d'erreur</h4>
							<p id="d-error" class="text-slate-700 text-xs font-mono"></p>
						</div>
					</div>
					<div class="flex justify-end mt-4">
						<button onclick="closeModal('detailModal')" class="px-4 py-2 bg-slate-600 text-white rounded-lg hover:bg-slate-700">Fermer</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Modales pour confirmation -->
		<div id="approveModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
			<div class="flex items-center justify-center min-h-screen px-4">
				<div class="bg-white rounded-lg max-w-md w-full p-6">
					<h3 class="text-lg font-medium text-slate-900 mb-4">Approuver la demande</h3>
					<p class="text-slate-600 mb-4">Voulez-vous vraiment approuver cette demande d'identifiants ?</p>
					<textarea id="approveNotes" placeholder="Notes optionnelles..." class="w-full p-3 border border-slate-300 rounded-lg mb-4"></textarea>
					<div class="flex justify-end space-x-3">
						<button onclick="closeModal('approveModal')" class="px-4 py-2 text-slate-600 hover:text-slate-800">Annuler</button>
						<button id="confirmApprove" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">Approuver</button>
					</div>
				</div>
			</div>
		</div>

		<div id="rejectModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
			<div class="flex items-center justify-center min-h-screen px-4">
				<div class="bg-white rounded-lg max-w-md w-full p-6">
					<h3 class="text-lg font-medium text-slate-900 mb-4">Rejeter la demande</h3>
					<p class="text-slate-600 mb-4">Voulez-vous vraiment rejeter cette demande d'identifiants ?</p>
					<textarea id="rejectReason" placeholder="Raison du rejet..." class="w-full p-3 border border-slate-300 rounded-lg mb-4"></textarea>
					<textarea id="rejectNotes" placeholder="Notes optionnelles..." class="w-full p-3 border border-slate-300 rounded-lg mb-4"></textarea>
					<div class="flex justify-end space-x-3">
						<button onclick="closeModal('rejectModal')" class="px-4 py-2 text-slate-600 hover:text-slate-800">Annuler</button>
						<button id="confirmReject" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">Rejeter</button>
					</div>
				</div>
			</div>
		</div>

		<script>
			let currentRequestId = null;

function showDetail(row) {
const d = row.dataset;
document.getElementById('d-name').textContent = d.detailFirstname + ' ' + d.detailLastname;
document.getElementById('d-email').textContent = d.detailEmail;
document.getElementById('d-phone').textContent = d.detailPhone || 'Non renseigné';
document.getElementById('d-createdat').textContent = d.detailCreatedat;
document.getElementById('d-processedat').textContent = d.detailProcessedat || 'Non traité';
const statusEl = document.getElementById('d-status');
const statusLabels = {
PENDING: 'En attente',
PROCESSING: 'En traitement',
COMPLETED: 'Complétée',
REJECTED: 'Rejetée',
FAILED: 'Échec'
};
const statusColors = {
PENDING: 'text-yellow-700',
PROCESSING: 'text-blue-700',
COMPLETED: 'text-green-700',
REJECTED: 'text-red-700',
FAILED: 'text-red-900'
};
statusEl.textContent = statusLabels[d.detailStatus] || d.detailStatus;
statusEl.className = 'font-bold ' + (
statusColors[d.detailStatus] || 'text-slate-900'
);
const parentSection = document.getElementById('d-parent-section');
if (d.detailParentEmail) {
document.getElementById('d-parent-name').textContent = d.detailParentFirstname + ' ' + d.detailParentLastname;
document.getElementById('d-parent-email').textContent = d.detailParentEmail;
document.getElementById('d-parent-role').textContent = d.detailParentRole;
parentSection.classList.remove('hidden');
} else {
parentSection.classList.add('hidden');
}
const notesSection = document.getElementById('d-notes-section');
if (d.detailNotes) {
document.getElementById('d-notes').textContent = d.detailNotes;
notesSection.classList.remove('hidden');
} else {
notesSection.classList.add('hidden');
}
const errorSection = document.getElementById('d-error-section');
if (d.detailError) {
document.getElementById('d-error').textContent = d.detailError;
errorSection.classList.remove('hidden');
} else {
errorSection.classList.add('hidden');
}
document.getElementById('detailModal').classList.remove('hidden');
}

function approveRequest(id) {
currentRequestId = id;
document.getElementById('approveModal').classList.remove('hidden');
}

function rejectRequest(id) {
currentRequestId = id;
document.getElementById('rejectModal').classList.remove('hidden');
}

function deleteRequest(id) {
if (confirm('Voulez-vous vraiment supprimer cette demande ?')) {
fetch (`/directeur/credentials/${id}/delete`, {
method: 'POST',
headers: {
'Content-Type': 'application/json'
}
}).then(response => response.json()).then(data => {
if (data.success) {
location.reload();
} else {
alert('Erreur: ' + data.message);
}
}).catch(error => {
console.error('Erreur:', error);
alert('Erreur lors de la suppression');
});
}
}

function closeModal(modalId) {
document.getElementById(modalId).classList.add('hidden');
currentRequestId = null;
}

document.getElementById('confirmApprove').addEventListener('click', function () {
const notes = document.getElementById('approveNotes').value;

fetch (`/directeur/credentials/${currentRequestId}/approve`, {
method: 'POST',
headers: {
'Content-Type': 'application/json'
},
body: JSON.stringify({notes})
}).then(response => response.json()).then(data => {
if (data.success) {
location.reload();
} else {
alert('Erreur: ' + data.message);
}
}).catch(error => {
console.error('Erreur:', error);
alert('Erreur lors de l\'approbation');
});
});

document.getElementById('confirmReject').addEventListener('click', function () {
const reason = document.getElementById('rejectReason').value;
const notes = document.getElementById('rejectNotes').value;

fetch (`/directeur/credentials/${currentRequestId}/reject`, {
method: 'POST',
headers: {
'Content-Type': 'application/json'
},
body: JSON.stringify(
{reason, notes}
)
}).then(response => response.json()).then(data => {
if (data.success) {
location.reload();
} else {
alert('Erreur: ' + data.message);
}
}).catch(error => {
console.error('Erreur:', error);
alert('Erreur lors du rejet');
});
});

// Fermer les modales en cliquant à l'extérieur
document.getElementById('approveModal').addEventListener('click', function (e) {
if (e.target === this) {
closeModal('approveModal');
}
});

document.getElementById('rejectModal').addEventListener('click', function (e) {
if (e.target === this) {
closeModal('rejectModal');
}
});

document.getElementById('detailModal').addEventListener('click', function (e) {
if (e.target === this) {
closeModal('detailModal');
}
});

// === FONCTIONS DE FILTRAGE ET TRI ===
function filterRequests() {
const searchText = document.getElementById('searchText').value.toLowerCase();
const filterStatus = document.getElementById('filterStatus').value;
const rows = document.querySelectorAll('tbody tr.request-row');
let visibleCount = 0;

rows.forEach(row => {
const firstName = row.dataset.firstname || '';
const lastName = row.dataset.lastname || '';
const email = row.dataset.email || '';
const status = row.dataset.status || '';

const fullName = firstName + ' ' + lastName;
const matchesSearch = ! searchText || fullName.includes(searchText) || email.includes(searchText);
const matchesStatus = ! filterStatus || status === filterStatus;

if (matchesSearch && matchesStatus) {
row.style.display = '';
visibleCount++;
} else {
row.style.display = 'none';
}
});

document.getElementById('resultsCount').textContent = visibleCount;
}

function sortRequests() {
const sortBy = document.getElementById('sortBy').value;
const tbody = document.querySelector('tbody');
const rows = Array.from(tbody.querySelectorAll('tr.request-row'));

rows.sort((a, b) => {
switch (sortBy) {
case 'date-desc':
return new Date(b.dataset.created) - new Date(a.dataset.created);
case 'date-asc':
return new Date(a.dataset.created) - new Date(b.dataset.created);
case 'name-asc':
return(a.dataset.lastnameRaw || a.dataset.lastname || '').localeCompare(b.dataset.lastnameRaw || b.dataset.lastname || '');
case 'name-desc':
return(b.dataset.lastnameRaw || b.dataset.lastname || '').localeCompare(a.dataset.lastnameRaw || a.dataset.lastname || '');
default:
return 0;
}
});

rows.forEach(row => tbody.appendChild(row));
}

// === LIAISON MANUELLE D'UN PARENT ===
function openLinkParentModal(requestId) {
currentRequestId = requestId;
document.getElementById('linkParentSearch').value = '';
document.getElementById('linkParentResults').innerHTML = '';
document.getElementById('linkParentModal').classList.remove('hidden');
}

let linkSearchTimeout = null;
document.addEventListener('input', function (e) {
if (e.target.id !== 'linkParentSearch') 
return;



clearTimeout(linkSearchTimeout);
const q = e.target.value.trim();
if (q.length < 2) {
document.getElementById('linkParentResults').innerHTML = '';
return;
}
linkSearchTimeout = setTimeout(() => {
fetch('/directeur/credentials/search-parents?q=' + encodeURIComponent(q)).then(r => r.json()).then(data => {
const container = document.getElementById('linkParentResults');
if (!data.success || data.parents.length === 0) {
container.innerHTML = '<p class="text-sm text-slate-500 py-2">Aucun parent trouvé pour "' + q + '"</p>';
return;
}
container.innerHTML = data.parents.map(p => `
<div class="flex items-center justify-between p-3 border border-slate-200 rounded-lg hover:bg-slate-50 cursor-pointer"
     onclick="confirmLinkParent(${
p.id
}, '${
p.firstName
} ${
p.lastName
}', '${
p.email
}')">
  <div>
    <div class="font-medium text-slate-900">${
p.firstName
} ${
p.lastName
}</div>
    <div class="text-sm text-slate-500">${
p.email
}</div>
  </div>
  <button class="text-xs bg-indigo-600 text-white px-3 py-1 rounded hover:bg-indigo-700">Sélectionner</button>
</div>
`).join('');
});
}, 300);
});

function confirmLinkParent(parentId, parentName, parentEmail) {
if (!confirm('Lier la demande au parent "' + parentName + '" (' + parentEmail + ') ?')) 
return;



fetch('/directeur/credentials/' + currentRequestId + '/link-parent', {
method: 'POST',
headers: {
'Content-Type': 'application/json'
},
body: JSON.stringify({parentId})
}).then(r => r.json()).then(data => {
if (data.success) {
closeModal('linkParentModal');
location.reload();
} else {
alert('Erreur: ' + data.message);
}
}).catch(() => alert('Erreur lors de la liaison'));
}

document.addEventListener('click', function (e) {
if (e.target.id !== 'linkParentModal') 
return;



closeModal('linkParentModal');


});
		</script>

		<!-- Modale Liaison Manuelle Parent -->
		<div id="linkParentModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
			<div class="flex items-center justify-center min-h-screen px-4">
				<div class="bg-white rounded-lg max-w-lg w-full p-6 shadow-xl">
					<div class="flex items-center justify-between mb-4">
						<h3 class="text-lg font-bold text-slate-900">🔍 Rechercher et lier un parent</h3>
						<button onclick="closeModal('linkParentModal')" class="text-slate-400 hover:text-slate-600">
							<svg class="h-6 w-6" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
							</svg>
						</button>
					</div>
					<p class="text-sm text-slate-600 mb-3">Recherchez le parent par nom, prénom ou email pour le lier à cette demande.</p>
					<input type="text" id="linkParentSearch" placeholder="Tapez un nom, prénom ou email..." class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent mb-3">
					<div id="linkParentResults" class="space-y-2 max-h-60 overflow-y-auto"></div>
					<div class="flex justify-between items-center mt-4 pt-4 border-t border-slate-200">
						<button onclick="openCreateParentModal()" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 text-sm">
							➕ Créer un nouveau compte parent
						</button>
						<button onclick="closeModal('linkParentModal')" class="px-4 py-2 bg-slate-600 text-white rounded-lg hover:bg-slate-700">Fermer</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Modal création manuelle d'un parent -->
		<div id="createParentModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
			<div class="flex items-center justify-center min-h-screen px-4">
				<div class="bg-white rounded-lg max-w-lg w-full p-6 shadow-xl">
					<div class="flex items-center justify-between mb-4">
						<h3 class="text-lg font-bold text-slate-900">➕ Créer un compte parent</h3>
						<button onclick="closeModal('createParentModal')" class="text-slate-400 hover:text-slate-600">
							<svg class="h-6 w-6" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
							</svg>
						</button>
					</div>
					<p class="text-sm text-slate-500 mb-4">Les champs sont pré-remplis avec les informations de la demande. Corrigez si nécessaire.</p>
					<div class="space-y-3">
						<div class="grid grid-cols-2 gap-3">
							<div>
								<label class="block text-sm font-medium text-slate-700 mb-1">Prénom *</label>
								<input type="text" id="createParentFirstName" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-green-500" placeholder="Prénom">
							</div>
							<div>
								<label class="block text-sm font-medium text-slate-700 mb-1">Nom *</label>
								<input type="text" id="createParentLastName" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-green-500" placeholder="NOM">
							</div>
						</div>
						<div>
							<label class="block text-sm font-medium text-slate-700 mb-1">Email *</label>
							<input type="email" id="createParentEmail" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-green-500" placeholder="email@exemple.fr">
						</div>
						<div>
							<label class="block text-sm font-medium text-slate-700 mb-1">Téléphone</label>
							<input type="text" id="createParentPhone" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-green-500" placeholder="06 xx xx xx xx">
						</div>
					</div>
					<div id="createParentError" class="mt-3 text-sm text-red-600 hidden"></div>
					<div class="flex justify-between items-center mt-5 pt-4 border-t border-slate-200">
						<button onclick="closeModal('createParentModal')" class="px-4 py-2 text-slate-600 hover:text-slate-800">Annuler</button>
						<button onclick="submitCreateParent()" class="px-5 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 font-medium">
							Créer et lier ce parent
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>

{% endblock %}
